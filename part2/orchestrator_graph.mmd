---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	extract(extract)
	chunk(chunk)
	retrieve(retrieve)
	generate(generate)
	reflect(reflect)
	__end__([<p>__end__</p>]):::last
	__start__ --> extract;
	chunk --> retrieve;
	extract --> chunk;
	generate --> reflect;
	reflect -. &nbsp;end&nbsp; .-> __end__;
	reflect -.-> extract;
	reflect -.-> generate;
	reflect -.-> retrieve;
	retrieve --> generate;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
